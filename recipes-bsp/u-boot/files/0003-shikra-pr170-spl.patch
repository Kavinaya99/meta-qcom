From b6cc2f5014ddb74998d518311339a6e62716686c Mon Sep 17 00:00:00 2001
From: Aswin Murugan <aswin.murugan@oss.qualcomm.com>
Date: Tue, 6 Oct 2026 13:05:40 +0530
Subject: [PATCH 1/3] arm: dts: shikra: mark console/storage/RPM nodes
 bootph-all for SPL

Add "bootph-all" to the gcc, tlmm, qup_uart0_default, sdc1_state_on,
sdc1_state_off, sdhc_1, qupv3_0, uart0, rpmcc and rpmpd nodes in
shikra-iqs-evk-u-boot.dtsi.

Upstream-Status: Pending
Signed-off-by: KR Sowmiya <kr.sowmiya@oss.qualcomm.com>
---
 arch/arm/dts/shikra-iqs-evk-u-boot.dtsi | 42 +++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/arch/arm/dts/shikra-iqs-evk-u-boot.dtsi b/arch/arm/dts/shikra-iqs-evk-u-boot.dtsi
index aede2957d97b..ab75b7d80e37 100644
--- a/arch/arm/dts/shikra-iqs-evk-u-boot.dtsi
+++ b/arch/arm/dts/shikra-iqs-evk-u-boot.dtsi
@@ -28,6 +28,48 @@
 	compatible = "qcom,shikra-imem", "syscon", "simple-mfd";
 };
 
+/* Keep the console and QUPFW storage paths in the SPL device tree. */
+&gcc {
+	bootph-all;
+};
+
+&tlmm {
+	bootph-all;
+};
+
+&qup_uart0_default {
+	bootph-all;
+};
+
+&sdc1_state_on {
+	bootph-all;
+};
+
+&sdc1_state_off {
+	bootph-all;
+};
+
+&sdhc_1 {
+	bootph-all;
+};
+
+&qupv3_0 {
+	bootph-all;
+};
+
+&uart0 {
+	bootph-all;
+};
+
+/* Retain the RPM clock and power-domain providers for boot consumers. */
+&rpmcc {
+	bootph-all;
+};
+
+&rpmpd {
+	bootph-all;
+};
+
 /* Enter Qualcomm EDL/download mode via "reset -edl". */
 &{/psci} {
 	reboot-mode {

