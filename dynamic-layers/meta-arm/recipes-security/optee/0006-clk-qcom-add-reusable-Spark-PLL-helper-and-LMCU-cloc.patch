From d9dabed9e310f96d2059a69e10b4d737748c29c9 Mon Sep 17 00:00:00 2001
From: Taniya Das <taniya.das@oss.qualcomm.com>
Date: Thu, 3 Sep 2026 12:40:05 +0530
Subject: [PATCH 06/10] clk: qcom: add reusable Spark PLL helper and LMCU clock
 group

The Bruin-family subsystems bring up a Spark PLL as part of their PIL
sequence. Add qcom_spark_pll_enable() to configure the PLL trim/config
registers, program the L/alpha/pre-div/VCO fields, request fine lock
detection and latch the PLL, then bound the lock wait via
REG_POLL_TIMEOUT() instead of the unbounded spin used by the reference
sequence. The generic PLL_MODE_* bit definitions are shared with the
existing Lucid-EVO helper since the mode-register layout is identical;
add PLL_MODE_BYPASSNL for the Spark latch step.

Also add the QCOM_CLKS_LMCU clock group so the low-power MCU subsystem
can be routed through the PAS clock path.

Upstream-Status: Pending
Signed-off-by: Taniya Das <taniya.das@oss.qualcomm.com>
---
 core/drivers/clk/qcom/clk.c     | 133 +++++++++++++++++++++++++-------
 core/include/drivers/clk_qcom.h |  21 +++++
 2 files changed, 128 insertions(+), 26 deletions(-)

diff --git a/core/drivers/clk/qcom/clk.c b/core/drivers/clk/qcom/clk.c
index f2bc88219..c38601cac 100644
--- a/core/drivers/clk/qcom/clk.c
+++ b/core/drivers/clk/qcom/clk.c
@@ -7,49 +7,75 @@
 #include <drivers/clk.h>
 #include <drivers/clk_qcom.h>
 #include <io.h>
+#include <kernel/delay.h>
 #include <mm/core_mmu.h>
 #include <trace.h>
 
 register_phys_mem(MEM_AREA_IO_NSEC, GCC_BASE, GCC_SIZE);
 
-#define CBCR_BRANCH_ENABLE_BIT		BIT(0)
-#define CBCR_HW_CTL_ENABLE_BIT		BIT(1)
-#define CBCR_BRANCH_OFF_BIT		BIT(31)
+#define CBCR_BRANCH_ENABLE_BIT			BIT(0)
+#define CBCR_HW_CTL_ENABLE_BIT			BIT(1)
+#define CBCR_BRANCH_OFF_BIT			BIT(31)
 
 /* Lucid-EVO PLL register offsets, relative to the PLL register block base. */
-#define PLL_MODE			0x0
-#define PLL_OPMODE			0x4
-#define PLL_L_VAL			0x10
-#define PLL_ALPHA_VAL			0x14
-#define PLL_USER_CTL			0x18
-#define PLL_USER_CTL_U			0x1c
-#define PLL_CONFIG_CTL			0x20
-#define PLL_CONFIG_CTL_U		0x24
-#define PLL_CONFIG_CTL_U1		0x28
+#define PLL_MODE				0x0
+#define PLL_OPMODE				0x4
+#define PLL_L_VAL				0x10
+#define PLL_ALPHA_VAL				0x14
+#define PLL_USER_CTL				0x18
+#define PLL_USER_CTL_U				0x1c
+#define PLL_CONFIG_CTL				0x20
+#define PLL_CONFIG_CTL_U			0x24
+#define PLL_CONFIG_CTL_U1			0x28
 
 /* PLL_MODE fields */
-#define PLL_MODE_OUTCTRL		BIT(0)
-#define PLL_MODE_RESET_N		BIT(2)
-#define PLL_MODE_LOCK_DET		BIT(31)
+#define PLL_MODE_OUTCTRL			BIT(0)
+#define PLL_MODE_BYPASSNL			BIT(1)
+#define PLL_MODE_RESET_N			BIT(2)
+#define PLL_MODE_LOCK_DET			BIT(31)
 
 /* PLL_OPMODE values */
-#define PLL_OPMODE_RUN			0x1
+#define PLL_OPMODE_RUN				0x1
 
 /* PLL_L_VAL fields */
-#define PLL_L_VAL_L_MASK		0x0000ffff
-#define PLL_L_VAL_CAL_L_SHIFT		16
-#define PLL_L_VAL_CAL_L_MASK		0xffff0000
+#define PLL_L_VAL_L_MASK			0x0000ffff
+#define PLL_L_VAL_CAL_L_SHIFT			16
+#define PLL_L_VAL_CAL_L_MASK			0xffff0000
 
 /* PLL_USER_CTL fields */
-#define PLL_USER_CTL_PLLOUT_MAIN_EN	BIT(0)
-#define PLL_USER_CTL_PRE_DIV_SHIFT	22
-#define PLL_USER_CTL_PRE_DIV_MASK	0x01c00000
-#define PLL_USER_CTL_POST_DIV_ODD_MASK	0x0003c000
-#define PLL_USER_CTL_POST_DIV_EVEN_MASK	0x00003c00
-#define PLL_USER_CTL_FRAC_FORMAT_SEL	BIT(28)
+#define PLL_USER_CTL_PLLOUT_MAIN_EN		BIT(0)
+#define PLL_USER_CTL_PRE_DIV_SHIFT		22
+#define PLL_USER_CTL_PRE_DIV_MASK		0x01c00000
+#define PLL_USER_CTL_POST_DIV_ODD_MASK		0x0003c000
+#define PLL_USER_CTL_POST_DIV_EVEN_MASK		0x00003c00
+#define PLL_USER_CTL_FRAC_FORMAT_SEL		BIT(28)
 
 /* PLL_USER_CTL_U fields */
-#define PLL_USER_CTL_U_FINE_LOCK_DET	BIT(0)
+#define PLL_USER_CTL_U_FINE_LOCK_DET		BIT(0)
+
+/* Spark PLL register offsets, relative to the PLL block base. */
+#define SPARK_PLL_MODE				0x0
+#define SPARK_PLL_L_VAL				0x4
+#define SPARK_PLL_ALPHA_VAL			0x8
+#define SPARK_PLL_ALPHA_VAL_U			0xc
+#define SPARK_PLL_USER_CTL			0x10
+#define SPARK_PLL_USER_CTL_U			0x14
+#define SPARK_PLL_CONFIG_CTL			0x18
+#define SPARK_PLL_TEST_CTL			0x1c
+#define SPARK_PLL_TEST_CTL_U			0x20
+
+/* SPARK_PLL_USER_CTL fields */
+#define SPARK_PLL_USER_CTL_PLLOUT_LV_MAIN	BIT(0)
+#define SPARK_PLL_USER_CTL_PRE_DIV_SHIFT	12
+#define SPARK_PLL_USER_CTL_PRE_DIV_MASK		0x7000
+#define SPARK_PLL_USER_CTL_VCO_SEL_SHIFT	20
+#define SPARK_PLL_USER_CTL_VCO_SEL_MASK		0x300000
+#define SPARK_PLL_USER_CTL_ALPHA_EN		BIT(24)
+
+/* SPARK_PLL_USER_CTL_U fields */
+#define SPARK_PLL_USER_CTL_U_LOCK_DET		BIT(2)
+#define SPARK_PLL_USER_CTL_U_CAL_L_SHIFT	16
+#define SPARK_PLL_USER_CTL_U_CAL_L_MASK		0xffff0000
 
 TEE_Result qcom_clock_enable_cbc(vaddr_t cbcr)
 {
@@ -137,6 +163,60 @@ TEE_Result qcom_clock_set_rate(vaddr_t cfg_rcgr, vaddr_t cmd_rcgr,
 	return TEE_SUCCESS;
 }
 
+TEE_Result qcom_spark_pll_enable(vaddr_t pll_base,
+				 const struct qcom_spark_pll_config *cfg)
+{
+	uint32_t user_val = 0;
+	int ret = 0;
+
+	/* SetRegSettings: program the static PLL trim/config registers. */
+	io_write32(pll_base + SPARK_PLL_CONFIG_CTL, cfg->config_ctl);
+	io_write32(pll_base + SPARK_PLL_TEST_CTL, cfg->test_ctl);
+	io_write32(pll_base + SPARK_PLL_TEST_CTL_U, cfg->test_ctl_u);
+	io_write32(pll_base + SPARK_PLL_USER_CTL, cfg->user_ctl);
+	io_write32(pll_base + SPARK_PLL_USER_CTL_U, cfg->user_ctl_u);
+
+	/* ConfigPLL: program L value, fractional value and VCO/pre-div. */
+	io_write32(pll_base + SPARK_PLL_L_VAL, cfg->l_val);
+	io_write32(pll_base + SPARK_PLL_ALPHA_VAL, cfg->alpha_val);
+
+	user_val = io_read32(pll_base + SPARK_PLL_USER_CTL);
+	user_val |= SPARK_PLL_USER_CTL_ALPHA_EN;
+	user_val &= ~(SPARK_PLL_USER_CTL_PRE_DIV_MASK |
+		      SPARK_PLL_USER_CTL_VCO_SEL_MASK);
+	if (cfg->pre_div >= 1 && cfg->pre_div <= 8)
+		user_val |= SHIFT_U32(cfg->pre_div - 1,
+				      SPARK_PLL_USER_CTL_PRE_DIV_SHIFT) &
+			    SPARK_PLL_USER_CTL_PRE_DIV_MASK;
+	user_val |= SHIFT_U32(cfg->vco_sel, SPARK_PLL_USER_CTL_VCO_SEL_SHIFT) &
+		    SPARK_PLL_USER_CTL_VCO_SEL_MASK;
+	io_write32(pll_base + SPARK_PLL_USER_CTL, user_val);
+
+	/* SetCalConfig: program the calibration L value. */
+	io_mask32(pll_base + SPARK_PLL_USER_CTL_U,
+		  SHIFT_U32(cfg->cal_l_val, SPARK_PLL_USER_CTL_U_CAL_L_SHIFT),
+		  SPARK_PLL_USER_CTL_U_CAL_L_MASK);
+
+	/* Enable: request fine lock detection, then latch and lock the PLL. */
+	io_setbits32(pll_base + SPARK_PLL_USER_CTL_U,
+		     SPARK_PLL_USER_CTL_U_LOCK_DET);
+	io_setbits32(pll_base + SPARK_PLL_MODE, PLL_MODE_BYPASSNL);
+	udelay(5);
+	io_setbits32(pll_base + SPARK_PLL_MODE, PLL_MODE_RESET_N);
+
+	/* Reference spins unbounded on LOCK_DET; bounded here via timeout. */
+	REG_POLL_TIMEOUT(pll_base + SPARK_PLL_MODE, 10 * 1000, 10, &ret,
+			 pll_locked);
+	if (ret < 0)
+		return TEE_ERROR_TIMEOUT;
+
+	io_setbits32(pll_base + SPARK_PLL_MODE, PLL_MODE_OUTCTRL);
+	io_setbits32(pll_base + SPARK_PLL_USER_CTL,
+		     SPARK_PLL_USER_CTL_PLLOUT_LV_MAIN);
+
+	return TEE_SUCCESS;
+}
+
 TEE_Result qcom_clock_enable(enum qcom_clk_group group)
 {
 	switch (group) {
@@ -146,6 +226,7 @@ TEE_Result qcom_clock_enable(enum qcom_clk_group group)
 	case QCOM_CLKS_WPSS:
 	case QCOM_CLKS_GPDSP0:
 	case QCOM_CLKS_GPDSP1:
+	case QCOM_CLKS_LMCU:
 		return qcom_clock_enable_pas(group);
 	default:
 		EMSG("Unsupported clock group %d", group);
diff --git a/core/include/drivers/clk_qcom.h b/core/include/drivers/clk_qcom.h
index ee187864e..abb721f72 100644
--- a/core/include/drivers/clk_qcom.h
+++ b/core/include/drivers/clk_qcom.h
@@ -32,6 +32,7 @@ enum qcom_clk_group {
 	QCOM_CLKS_LPASS,
 	QCOM_CLKS_GPDSP0,
 	QCOM_CLKS_GPDSP1,
++	QCOM_CLKS_LMCU,
 	QCOM_CLKS_MAX,
 };
 
@@ -59,6 +60,20 @@ struct qcom_lucidevo_pll_config {
 	bool frac_mode_mn;		/* false = alpha (default for Q6) */
 };
 
+/* Register configuration for a Spark PLL. */
+struct qcom_spark_pll_config {
+	uint32_t l_val;
+	uint32_t cal_l_val;
+	uint32_t alpha_val;
+	uint32_t pre_div;		/* div-1..div-8; 0 = div-1 */
+	uint32_t vco_sel;
+	uint32_t config_ctl;
+	uint32_t test_ctl;
+	uint32_t test_ctl_u;
+	uint32_t user_ctl;
+	uint32_t user_ctl_u;
+};
+
 TEE_Result qcom_clock_enable(enum qcom_clk_group group);
 TEE_Result qcom_clock_enable_cbc(vaddr_t cbcr);
 TEE_Result qcom_clock_set_rate(vaddr_t cfg_rcgr, vaddr_t cmd_rcgr,
@@ -70,6 +85,12 @@ TEE_Result qcom_clock_set_rate(vaddr_t cfg_rcgr, vaddr_t cmd_rcgr,
 TEE_Result qcom_lucidevo_pll_enable(vaddr_t pll_base,
 				    const struct qcom_lucidevo_pll_config *cfg);
 
+/* Configure, lock and enable a Spark PLL at @pll_base; returns
+ * TEE_ERROR_TIMEOUT if it fails to lock.
+ */
+TEE_Result qcom_spark_pll_enable(vaddr_t pll_base,
+				 const struct qcom_spark_pll_config *cfg);
+
 #if defined(CFG_QCOM_CLK_CFG)
 /*
  * qcom has no secure DT, so a consumer acquires the clk by name instead
-- 
