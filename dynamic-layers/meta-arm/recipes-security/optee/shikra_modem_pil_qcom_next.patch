+static TEE_Result modem_setup(void)
+{
+	struct io_pa_va mss_io = { .pa = MSS_BASE };
+	vaddr_t mss = io_pa_or_va(&mss_io, MSS_SIZE);
+	struct io_pa_va core_cc_io = { .pa = MSS_CORE_CC_BASE };
+	vaddr_t core_cc = io_pa_or_va(&core_cc_io, MSS_CORE_CC_SIZE);
+	struct io_pa_va clk_ctl_io = { .pa = GCC_BASE };
+	vaddr_t clk_ctl = io_pa_or_va(&clk_ctl_io, GCC_SIZE);
+	struct io_pa_va mss_cc_io = { .pa = MSS_CC_BASE };
+	vaddr_t mss_cc = io_pa_or_va(&mss_cc_io, MSS_CC_SIZE);
+	struct io_pa_va mss_rst_io = { .pa = GCC_MSS_RESTART_BASE };
+	vaddr_t mss_rst = io_pa_or_va(&mss_rst_io, sizeof(uint32_t));
+	static bool post_boot_imem_reset_done;
+	uint32_t dbg_val = 0;
+
+	if (!mss || !core_cc || !clk_ctl || !mss_cc || !mss_rst)
+		return TEE_ERROR_GENERIC;
+
+	if (qcom_clock_enable_cbc(clk_ctl + GCC_MSS_CFG_AHB_CBCR) !=
+	    TEE_SUCCESS)
+		return TEE_ERROR_TIMEOUT;
+
+	if (qcom_clock_enable_cbc(mss_cc + MSS_CC_XO_Q6_CBCR) != TEE_SUCCESS)
+		return TEE_ERROR_TIMEOUT;
+
+	if (qcom_clock_enable_cbc(clk_ctl + GCC_MSS_CE_AXI_CBCR) !=
+	    TEE_SUCCESS)
+		return TEE_ERROR_TIMEOUT;
+
+	io_mask32(clk_ctl + GCC_MSS_Q6SS_BOOT_GPLL0_MUXR, 0x0,
+		  GCC_MSS_Q6SS_BOOT_GPLL0_MUXR_MUX_SEL_MASK);
+
+	if (!post_boot_imem_reset_done) {
+		dbg_val = io_read32(mss + MSS_QDSP6SS_DBG_CFG);
+
+		io_setbits32(mss_cc + MSS_CC_MSS_ALT_RESET_Q6SS,
+			     MSS_ALT_RESET_Q6SS_EN_BIT);
+		udelay(100);
+
+		io_setbits32(mss_rst, GCC_MSS_RESTART_SS_RESTART_BIT);
+		udelay(300);
+
+		io_clrbits32(mss_rst, GCC_MSS_RESTART_SS_RESTART_BIT);
+		udelay(100);
+
+		io_clrbits32(mss_cc + MSS_CC_MSS_ALT_RESET_Q6SS,
+			     MSS_ALT_RESET_Q6SS_EN_BIT);
+
+		io_write32(mss + MSS_QDSP6SS_DBG_CFG, dbg_val);
+		post_boot_imem_reset_done = true;
+	}
+
+	io_setbits32(core_cc + MSS_QDSP6SS_CORE_CBCR, MSS_CORE_CBCR_CLKEN_BIT);
+
+	return TEE_SUCCESS;
+}
