+static TEE_Result modem_enable_processor(void)
+{
+	struct io_pa_va mss_io = { .pa = MSS_BASE };
+	vaddr_t mss = io_pa_or_va(&mss_io, MSS_SIZE);
+	struct io_pa_va core_cc_io = { .pa = MSS_CORE_CC_BASE };
+	vaddr_t core_cc = io_pa_or_va(&core_cc_io, MSS_CORE_CC_SIZE);
+	uint64_t timeout = 0;
+	TEE_Result res = TEE_SUCCESS;
+
+	if (!mss || !core_cc)
+		return TEE_ERROR_GENERIC;
+
+	io_write32(mss + MSS_QDSP6SS_RET_CFG, 0);
+
+	io_write32(mss + MSS_QDSP6SS_BOOT_CORE_START, 1);
+	io_write32(mss + MSS_QDSP6SS_BOOT_AUTO_BREAK_EN, 1);
+	io_write32(mss + MSS_QDSP6SS_BOOT_CMD, 1);
+
+	timeout = timeout_init_us(200000 * 5);
+	while (!(io_read32(mss + MSS_QDSP6SS_BOOT_STATUS) &
+		 MSS_BOOT_STATUS_AUTO_BREAK_BIT)) {
+		if (timeout_elapsed(timeout))
+			return TEE_ERROR_TIMEOUT;
+		udelay(5);
+	}
+
+	res = qcom_spark_pll_enable(core_cc + MSS_QDSP6SS_PLL_BASE_OFFSET,
+				    &mss_q6_pll_cfg);
+	if (res != TEE_SUCCESS)
+		return res;
+
+	res = qcom_clock_set_rate(core_cc + MSS_QDSP6SS_CORE_CFG_RCGR,
+				  core_cc + MSS_QDSP6SS_CORE_CMD_RCGR,
+				  MSS_Q6CFG_RCG_VAL);
+	if (res != TEE_SUCCESS)
+		return res;
+
+	io_write32(mss + MSS_QDSP6SS_BOOT_RESUME_CMD, 1);
+
+	timeout = timeout_init_us(200000 * 5);
+	while (!(io_read32(mss + MSS_QDSP6SS_BOOT_STATUS) &
+		 MSS_BOOT_STATUS_DONE_BIT)) {
+		if (timeout_elapsed(timeout))
+			return TEE_ERROR_TIMEOUT;
+		udelay(5);
+	}
+
+	io_write32(mss + MSS_QDSP6SS_BOOT_CORE_START, 1);
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result modem_reset_processor(void)
+{
+	struct io_pa_va mss_io = { .pa = MSS_BASE };
+	vaddr_t mss = io_pa_or_va(&mss_io, MSS_SIZE);
+	struct io_pa_va mss_rst_io = { .pa = GCC_MSS_RESTART_BASE };
+	vaddr_t mss_rst = io_pa_or_va(&mss_rst_io, sizeof(uint32_t));
+	struct io_pa_va tcsr_io = { .pa = MSS_TCSR_HALT_BASE };
+	vaddr_t tcsr = io_pa_or_va(&tcsr_io, MSS_TCSR_HALT_SIZE);
+	uint64_t timeout = 0;
+
+	if (!mss || !mss_rst || !tcsr)
+		return TEE_ERROR_GENERIC;
+
+	io_write32(mss + MSS_QDSP6SS_RET_CFG, 0x3);
+
+	io_setbits32(tcsr + TCSR_MSSQ6_HALTREQ, TCSR_HALT_BIT);
+	timeout = timeout_init_us(200000 * 5);
+	while (!(io_read32(tcsr + TCSR_MSSQ6_HALTACK) & TCSR_HALT_BIT)) {
+		if (timeout_elapsed(timeout))
+			break;
+		udelay(5);
+	}
+
+	io_setbits32(tcsr + TCSR_MSS_MODEM_HALTREQ, TCSR_HALT_BIT);
+	timeout = timeout_init_us(200000 * 5);
+	while (!(io_read32(tcsr + TCSR_MSS_MODEM_HALTACK) & TCSR_HALT_BIT)) {
+		if (timeout_elapsed(timeout))
+			return TEE_ERROR_TIMEOUT;
+		udelay(5);
+	}
+
+	io_setbits32(tcsr + TCSR_MSS_NC_HALTREQ, TCSR_HALT_BIT);
+	timeout = timeout_init_us(200000 * 5);
+	while (!(io_read32(tcsr + TCSR_MSS_NC_HALTACK) & TCSR_HALT_BIT)) {
+		if (timeout_elapsed(timeout))
+			return TEE_ERROR_TIMEOUT;
+		udelay(5);
+	}
+
+	io_write32(tcsr + TCSR_MSSQ6_HALTREQ, 0x0);
+	io_write32(tcsr + TCSR_MSS_MODEM_HALTREQ, 0x0);
+	io_write32(tcsr + TCSR_MSS_NC_HALTREQ, 0x0);
+
+	io_setbits32(mss_rst, GCC_MSS_RESTART_SS_RESTART_BIT);
+
+	udelay(200);
+
+	io_clrbits32(mss_rst, GCC_MSS_RESTART_SS_RESTART_BIT);
+
+	return TEE_SUCCESS;
+}
