@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#include <io.h>
+#include <platform_config.h>
+#include <stdint.h>
+#include <drivers/clk_qcom.h>
+
+#include "modem.h"
+
+/*
+ * RST_EVB lives at offset 0x10 into the MSS QDSP6SS PUB register block,
+ * which starts at MSS_BASE (see clock_group.h's MSS_QDSP6SS_RST_EVB).
+ * EVB is bits [27:4], i.e. the entry address >> 4.
+ */
+#define MSS_QDSP6SS_RST_EVB		0x10
+
+static TEE_Result modem_fw_start(struct qcom_pas_data *data)
+{
+	vaddr_t base = io_pa_or_va(&data->base, data->size);
+
+	if (!base)
+		return TEE_ERROR_GENERIC;
+
+	/*
+	 * Program the firmware entry point. The Q6 is released later, once
+	 * its PLL is configured, by qcom_clock_enable_pas_processor().
+	 */
+	io_write32(base + MSS_QDSP6SS_RST_EVB, data->fw_base >> 4);
+	dsb();
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result modem_fw_shutdown(struct qcom_pas_data *data)
+{
+	return qcom_clock_pas_reset(data->clk_group);
+}
+
+const struct qcom_pas_ops modem_ops = {
+	.fw_start = modem_fw_start,
+	.fw_shutdown = modem_fw_shutdown,
+};
