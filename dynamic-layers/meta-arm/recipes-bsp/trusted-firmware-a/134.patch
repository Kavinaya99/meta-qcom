index 9d02329ca..af09dd433 100644
--- a/plat/qti/hoya/kodiak/inc/kodiak_def.h
+++ b/plat/qti/hoya/kodiak/inc/kodiak_def.h
@@ -47,6 +47,7 @@
 /*----------------------------------------------------------------------------*/
 #define PON_PS_HOLD_RESET_CTL			0x852
 #define PON_PS_HOLD_RESET_CTL2			0x853
+#define PON_SOFT_RB_SPARE			0x7148
 /*----------------------------------------------------------------------------*/
 /* APSS HM registers */
 /*----------------------------------------------------------------------------*/
@@ -67,6 +68,10 @@
 #define QTI_CORE_TOP_CSR_BASE			0x01f00000
 #define QTI_CORE_TOP_CSR_BASE_SIZE		0x00100000
 /*----------------------------------------------------------------------------*/
+/* TCSR reboot-reason scratch register (CORE_TOP_CSR_BASE + 0xC0000 + 0x13000) */
+/*----------------------------------------------------------------------------*/
+#define TCSR_BOOT_MISC_DETECT			0x1FD3000
+/*----------------------------------------------------------------------------*/
 /* Platform-specific SMMU config base addresses */
 /*----------------------------------------------------------------------------*/
 #define QTI_SMMU_CFG_BASE			0x15000000
diff --git a/plat/qti/hoya/lemans/inc/lemans_def.h b/plat/qti/hoya/lemans/inc/lemans_def.h
index bfadf1f6c..49cc3ddbd 100644
--- a/plat/qti/hoya/lemans/inc/lemans_def.h
+++ b/plat/qti/hoya/lemans/inc/lemans_def.h
@@ -64,6 +64,7 @@
 /*----------------------------------------------------------------------------*/
 #define PON_PS_HOLD_RESET_CTL			0x852
 #define PON_PS_HOLD_RESET_CTL2			0x853
+#define PON_SOFT_RB_SPARE			0x7148
 /*----------------------------------------------------------------------------*/
 /* APSS HM registers */
 /*----------------------------------------------------------------------------*/
@@ -80,6 +81,10 @@
 #define QTI_CORE_TOP_CSR_BASE			0x01f00000
 #define QTI_CORE_TOP_CSR_BASE_SIZE		0x00100000
 /*----------------------------------------------------------------------------*/
+/* TCSR reboot-reason scratch register (CORE_TOP_CSR_BASE + 0xC0000 + 0x13000) */
+/*----------------------------------------------------------------------------*/
+#define TCSR_BOOT_MISC_DETECT			0x1FD3000
+/*----------------------------------------------------------------------------*/
 /* QTIMER registers                                                           */
 /*----------------------------------------------------------------------------*/
 #define QTI_QTIMER_BASE				0x17C20000
diff --git a/plat/qti/hoya/monaco/inc/monaco_def.h b/plat/qti/hoya/monaco/inc/monaco_def.h
index 4b5442252..14873a8d3 100644
--- a/plat/qti/hoya/monaco/inc/monaco_def.h
+++ b/plat/qti/hoya/monaco/inc/monaco_def.h
@@ -43,6 +43,7 @@
 /*----------------------------------------------------------------------------*/
 #define PON_PS_HOLD_RESET_CTL			0x852
 #define PON_PS_HOLD_RESET_CTL2			0x853
+#define PON_SOFT_RB_SPARE			0x7148
 
 /*----------------------------------------------------------------------------*/
 /* APSS HM, AOSS and CORE_TOP_CSR registers */
@@ -51,6 +52,11 @@
 #define QTI_AOSS_BASE				0x0b000000
 #define QTI_CORE_TOP_CSR_BASE			0x01f00000
 
+/*----------------------------------------------------------------------------*/
+/* TCSR reboot-reason scratch register (CORE_TOP_CSR_BASE + 0xC0000 + 0x13000) */
