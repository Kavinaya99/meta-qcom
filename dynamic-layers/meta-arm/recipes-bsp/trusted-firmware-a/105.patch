-		if (get_xpu_type(mpu) != XPU_TYPE_MPU)
-			continue;
-
-		uint32_t dev_cnt = range->device_prtn_cnt;
-
-		xpu_init_unused_regions(mpu, dev_cnt);
-		enable_domain(mpu);
-	}
