+}
+
+int vmidmt_cfg_get_intr_reg(enum vmidmt_intr_id id,
+			    const struct vmidmt_intr_reg **reg)
+{
+	if (id >= VMIDMT_INTR_COUNT) {
+		return -1;
+	}
+
+	*reg = &g_vmidmt_intr_reg[id];
+
+	return 0;
+}
