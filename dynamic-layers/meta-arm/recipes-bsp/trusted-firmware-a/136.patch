+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * QFPROM eFuse shadow-register addresses and bitfields used by the CPR10
+ * (Silver), CPR11 (Gold) and CPR12 (L3) voltage/quotient calibration data,
+ * curated out of the vendor vpp_security_hwio.h for shikra.
+ */
+
+#ifndef VPP_FUSE_HWIO_H
+#define VPP_FUSE_HWIO_H
+
+#include <lib/mmio.h>
+
+#define SECURITY_CONTROL_CORE_REG_BASE		0x01b40000UL
+
+#define QFPROM_RAW_CALIB_ROW4_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x278)
+
+#define QFPROM_CORR_PTE_ROW3_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4198)
+#define QFPROM_CORR_CALIB_ROW3_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4274)
+#define QFPROM_CORR_CALIB_ROW4_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4278)
+#define QFPROM_CORR_CALIB_ROW4_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x427c)
+#define QFPROM_CORR_CALIB_ROW5_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4280)
+#define QFPROM_CORR_CALIB_ROW5_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4284)
+#define QFPROM_CORR_CALIB_ROW6_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4288)
+#define QFPROM_CORR_CALIB_ROW6_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x428c)
+#define QFPROM_CORR_CALIB_ROW7_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4290)
+#define QFPROM_CORR_CALIB_ROW7_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4294)
+#define QFPROM_CORR_CALIB_ROW8_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4298)
+#define QFPROM_CORR_CALIB_ROW8_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x429c)
+#define QFPROM_CORR_CALIB_ROW9_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x42a0)
+#define QFPROM_CORR_CALIB_ROW9_MSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x42a4)
+#define QFPROM_CORR_QC_SPARE_REG20_LSB		(SECURITY_CONTROL_CORE_REG_BASE + 0x4438)
+
+#define SPEED_BIN_BMSK				0xfc
+#define SPEED_BIN_SHFT				2
+#define PTE_MCN_IDENTIFIER_BMSK			0x100
+#define PTE_MCN_IDENTIFIER_SHFT			8
+
+#define CPR_LOCAL_RC_BMSK			0xf0
+#define CPR_LOCAL_RC_SHFT			4
+
+#define SW_SPT_LOCAL_RAILS_VPID_BMSK		0xf0
+#define SW_SPT_LOCAL_RAILS_VPID_SHFT		4
+
+#define CPR12_QUOT_OFFSET_BMSK			0xff000
+#define CPR12_QUOT_OFFSET_SHFT			12
+
+#define CPR12_QUOT_MIN_LSVS_BMSK		0xfff00000
+#define CPR12_QUOT_MIN_LSVS_SHFT		20
+#define CPR12_TARG_VOLT_LSVS_BMSK		0x3f000000
+#define CPR12_TARG_VOLT_LSVS_SHFT		24
+#define CPR12_QUOT_MIN_NOM_BMSK			0xfff000
+#define CPR12_QUOT_MIN_NOM_SHFT			12
+#define CPR12_QUOT_MIN_SVS_BMSK			0xfff
+#define CPR12_QUOT_MIN_SVS_SHFT			0
+#define CPR12_TARG_VOLT_SVS_BMSK		0x3f000000
+#define CPR12_TARG_VOLT_SVS_SHFT		24
+#define CPR12_QUOT_MIN_BOOST_BMSK		0xfff000
+#define CPR12_QUOT_MIN_BOOST_SHFT		12
+#define CPR12_QUOT_MIN_TUR_BMSK			0xfff
+#define CPR12_QUOT_MIN_TUR_SHFT			0
+#define CPR12_TARG_VOLT_BOOST_BMSK		0x3f000
+#define CPR12_TARG_VOLT_BOOST_SHFT		12
+#define CPR12_TARG_VOLT_TUR_BMSK		0xfc0
+#define CPR12_TARG_VOLT_TUR_SHFT		6
+#define CPR12_TARG_VOLT_NOM_BMSK		0x3f
+#define CPR12_TARG_VOLT_NOM_SHFT		0
+
+#define CPR11_TARG_VOLT_LSVS_BMSK		0xfc000000
+#define CPR11_TARG_VOLT_LSVS_SHFT		26
+#define CPR11_QUOT_OFFSET_BMSK			0x3fc0000
+#define CPR11_QUOT_OFFSET_SHFT			18
+#define CPR11_TARG_VOLT_SVS_BMSK		0x3f000000
+#define CPR11_TARG_VOLT_SVS_SHFT		24
+#define CPR11_QUOT_MIN_SVS_BMSK			0xfff000
+#define CPR11_QUOT_MIN_SVS_SHFT			12
+#define CPR11_QUOT_MIN_LSVS_BMSK		0xfff
+#define CPR11_QUOT_MIN_LSVS_SHFT		0
+#define CPR11_TARG_VOLT_NOM_BMSK		0x3f000000
+#define CPR11_TARG_VOLT_NOM_SHFT		24
+#define CPR11_QUOT_MIN_TUR_BMSK			0xfff000
+#define CPR11_QUOT_MIN_TUR_SHFT			12
+#define CPR11_QUOT_MIN_NOM_BMSK			0xfff
+#define CPR11_QUOT_MIN_NOM_SHFT			0
+#define CPR11_TARG_VOLT_TUR_BMSK		0x3f000000
+#define CPR11_TARG_VOLT_TUR_SHFT		24
+#define CPR11_QUOT_MIN_BOOST_BMSK		0xfff
+#define CPR11_QUOT_MIN_BOOST_SHFT		0
+#define CPR11_TARG_VOLT_BOOST_BMSK		0x3f
+#define CPR11_TARG_VOLT_BOOST_SHFT		0
+
+#define CPR10_QUOT_MIN_LSVS_BMSK		0xfff00000
+#define CPR10_QUOT_MIN_LSVS_SHFT		20
+#define CPR10_QUOT_OFFSET_BMSK			0xff000
+#define CPR10_QUOT_OFFSET_SHFT			12
+#define CPR10_TARG_VOLT_LSVS_BMSK		0x3f000
+#define CPR10_TARG_VOLT_LSVS_SHFT		12
+#define CPR10_QUOT_MIN_SVS_BMSK			0xfff
+#define CPR10_QUOT_MIN_SVS_SHFT			0
+#define CPR10_TARG_VOLT_SVS_BMSK		0x3f000000
+#define CPR10_TARG_VOLT_SVS_SHFT		24
+#define CPR10_QUOT_MIN_TUR_BMSK			0xfff000
+#define CPR10_QUOT_MIN_TUR_SHFT			12
+#define CPR10_QUOT_MIN_NOM_BMSK			0xfff
+#define CPR10_QUOT_MIN_NOM_SHFT			0
+#define CPR10_TARG_VOLT_NOM_BMSK		0x7e00000
+#define CPR10_TARG_VOLT_NOM_SHFT		21
+#define CPR10_QUOT_MIN_BOOST_BMSK		0x1ffe00
+#define CPR10_QUOT_MIN_BOOST_SHFT		9
+#define CPR10_TARG_VOLT_BOOST_BMSK		0xfc0
+#define CPR10_TARG_VOLT_BOOST_SHFT		6
+#define CPR10_TARG_VOLT_TUR_BMSK		0x3f
+#define CPR10_TARG_VOLT_TUR_SHFT		0
+
+#define VPP_HWIO_INM(reg, field)	((mmio_read_32(reg) & field##_BMSK) >> field##_SHFT)
+
+/* Bit format documented in the fusing guide. */
+#define VPP_CLV_QUOT_OFFSET_PACK_FACTOR		5
+#define VPP_APC_VOLTAGE_VALUE_BMSK		0x1f
+#define VPP_APC_SIGN_BMSK			0x20
+#define VPP_APC_OLV_PACKING_FACTOR		8
+
+#define VPP_OLV_SIGN(val)	(((val) & VPP_APC_SIGN_BMSK) ? -1 : 1)
+#define VPP_OLV_VAL(val)	(((val) & VPP_APC_VOLTAGE_VALUE_BMSK) * VPP_APC_OLV_PACKING_FACTOR)
+#define VPP_OLV(val)		(VPP_OLV_VAL(val) * VPP_OLV_SIGN(val))
+
+#endif /* VPP_FUSE_HWIO_H */
