diff --git a/drivers/qti/cprh/shikra/cprh_hwio.h b/drivers/qti/cprh/shikra/cprh_hwio.h
new file mode 100644
index 000000000..01db2fe0b
--- /dev/null
+++ b/drivers/qti/cprh/shikra/cprh_hwio.h
@@ -0,0 +1,159 @@
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * shikra CPRH register map. Only the registers touched by the real
+ * boot-init path (cprh_hal_create_controller/thread, base-target/virtual-
+ * corner setup, DCVSH/measurement enable, APM crossover) are defined here;
+ * aging/AVG/sdelta-only registers are not ported.
+ */
+
+#ifndef CPRH_HWIO_H
+#define CPRH_HWIO_H
