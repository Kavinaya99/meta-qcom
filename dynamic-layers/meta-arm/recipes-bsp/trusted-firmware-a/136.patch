+#define RIMPSFAST_BASE			(QTI_APSS_HM_BASE + 0x00d80000U)
+
+#define RIMPSFAST_RIMPS_MUC_CLK_CTRL	(RIMPSFAST_BASE + 0x0U)
+#define RIMPSFAST_RIMPS_MUC_CLK_CTRL_CORE_CLK_EN_BMSK		0x2U
+#define RIMPSFAST_RIMPS_MUC_CLK_CTRL_CORE_CLK_EN_SHFT		1U
+#define RIMPSFAST_RIMPS_MUC_CLK_CTRL_CORE_SS_CLK_EN_BMSK	0x1U
+#define RIMPSFAST_RIMPS_MUC_CLK_CTRL_CORE_SS_CLK_EN_SHFT	0U
+
+#define RIMPSFAST_CPU_LPM_ARB_CTL	(RIMPSFAST_BASE + 0xfcU)
+#define RIMPSFAST_CPU_LPM_IRQ_EN	(RIMPSFAST_BASE + 0xecU)
+#define RIMPSFAST_CL_LPM_IRQ_EN		(RIMPSFAST_BASE + 0x10cU)
+
+/*
+ * RIMPSTOP: CPUCP global enable / secure-access / L3-voting control.
+ */
+#define RIMPSTOP_BASE			(QTI_APSS_HM_BASE + 0x00d98000U)
+
+#define RIMPSTOP_SECURE_ACCESS_OVERRIDE	(RIMPSTOP_BASE + 0x0U)
+#define RIMPSTOP_SECURE_ACCESS_OVERRIDE_CLKDOM_TIMER_NON_SECURE_ACCESS_EN_BMSK	0x8U
+#define RIMPSTOP_SECURE_ACCESS_OVERRIDE_CLKDOM_TIMER_NON_SECURE_ACCESS_EN_SHFT	3U
+#define RIMPSTOP_SECURE_ACCESS_OVERRIDE_SECURE_ACCESS_OVERRIDE_BMSK		0x1U
+#define RIMPSTOP_SECURE_ACCESS_OVERRIDE_SECURE_ACCESS_OVERRIDE_SHFT		0U
+
+#define RIMPSTOP_GLOBAL_ENABLE		(RIMPSTOP_BASE + 0x4U)
+#define RIMPSTOP_GLOBAL_ENABLE_GLOBAL_ENABLE_BMSK	0x1U
+#define RIMPSTOP_GLOBAL_ENABLE_GLOBAL_ENABLE_SHFT	0U
+
+/* L3-voting enable; vendor always leaves this disabled (see rimps.c). */
+#define RIMPSTOP_L3_VOTING_EN		(RIMPSTOP_BASE + 0x24U)
+#define RIMPSTOP_L3_VOTING_EN_ENABLE_BMSK	0x1U
+#define RIMPSTOP_L3_VOTING_EN_ENABLE_SHFT	0U
+
+/*
+ * RIMPS/EPSS CPUCP TCM: instruction region at the base, shared-data region
+ * 0x4000 past it. rimps_fw.c's load loop writes the firmware blob here.
+ */
+#define RIMPS_EPSS_BASE				(QTI_APSS_HM_BASE + 0x00d00000U)
+#define RIMPS_EPSS_SHARED_DATA_BASE		(RIMPS_EPSS_BASE + 0x4000U)
+
+/*
+ * IDDQ_APC_ACTIVE fuse, used by the MPMM_GEAR calculation in rimps.c.
+ */
+#define SECURITY_CONTROL_CORE_BASE		0x01b40000U
+
+#define QFPROM_CORR_PTE_ROW1_MSB		(SECURITY_CONTROL_CORE_BASE + 0x418cU)
+#define QFPROM_CORR_PTE_ROW1_MSB_IDDQ_APC_ACTIVE_BMSK	0x7fe00U
+#define QFPROM_CORR_PTE_ROW1_MSB_IDDQ_APC_ACTIVE_SHFT	9U
+
+#endif /* RIMPS_HWIO_H */
diff --git a/drivers/qti/rimps/shikra/rimps_init.c b/drivers/qti/rimps/shikra/rimps_init.c
new file mode 100644
index 000000000..202d520b2
--- /dev/null
+++ b/drivers/qti/rimps/shikra/rimps_init.c
@@ -0,0 +1,96 @@
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * RIMPS CPU PLL bring-up for shikra.
+ *
+ * The vendor TZ reference enables each CPU PLL and parks its domain's mux on
+ * it at a safe frequency before handing off to the full OSM/DCVS runtime
+ * ("The CPU PLL needs to be configured/enabled prior to enabling OSM, so set
+ * an initial safe frequency to run from it."). RIMPS's power-collapse
+ * opcode sequences carry that same assumption forward: they expect the PLLs
+ * already locked and outputting when a core first idles. This file ports
+ * only that static bring-up slice (Clock_EnableCPUPLL/Clock_SetCPUFrequency
+ * for the cold-boot safe frequency); the LUT-driven DCVS runtime itself,
+ * the CPUCP firmware that implements it, and ACD/AVG/BCL/APM are not
+ * ported.
+ *
+ * PLL_CONFIG_CTL/PLL_TEST_CTL/PLL_USER_CTL are left at their power-on-reset
+ * values, same as the vendor reference (its own comment marks them
+ * "not urgent for RUMI"); this is carried forward as an open caveat rather
+ * than silently resolved.
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <common/debug.h>
+#include <drivers/delay_timer.h>
+#include <lib/mmio.h>
+#include <lib/utils_def.h>
+
+#include <drivers/qti/rimps/rimps.h>
+
+#include "rimps_hwio.h"
+
+/* Cold-boot safe CPU PLL frequency: 652.8 MHz / 19.2 MHz XO = L-val 34. */
+#define RIMPS_COLD_BOOT_L_VAL		34U
+
+/* CFG_GFMUX source select to run the domain from its CPU PLL. */
+#define RIMPS_GFMUX_SRC_CPUPLL_EARLY	2U
+
+#define RIMPS_PLL_LOCK_POLL_RETRIES		1000U
+
+struct rimps_pll_domain {
+	uintptr_t base;
+	bool is_gold;
+};
+
+static const struct rimps_pll_domain rimps_domains[] = {
+	{ .base = L3_APSS_KRYO_CLK_CTL_BASE,     .is_gold = false },
+	{ .base = SILVER_APSS_KRYO_CLK_CTL_BASE, .is_gold = false },
+	{ .base = GOLD_APSS_KRYO_CLK_CTL_BASE,   .is_gold = true  },
+};
+
+static void rimps_enable_cpu_pll(const struct rimps_pll_domain *domain)
+{
+	uint32_t retry = RIMPS_PLL_LOCK_POLL_RETRIES;
+
+	if (domain->is_gold) {
+		mmio_write_32(GOLD_PLL_APC_PDN, 0U);
+	}
+
+	mmio_setbits_32(PLL_MODE(domain->base), PLL_MODE_BYPASSNL_BMSK);
+	udelay(5U);
+	mmio_setbits_32(PLL_MODE(domain->base), PLL_MODE_RESET_N_BMSK);
+
+	while (((mmio_read_32(PLL_MODE(domain->base)) &
+		 PLL_MODE_PLL_LOCK_DET_BMSK) == 0U) &&
+	       (--retry > 0U)) {
+		udelay(1U);
+	}
+
+	if (retry == 0U) {
+		WARN("rimps: CPU PLL @ 0x%lx lock timed out\n", domain->base);
+	}
+
+	mmio_setbits_32(PLL_MODE(domain->base), PLL_MODE_OUTCTRL_BMSK);
+}
+
+void rimps_cpu_pll_init(void)
+{
+	size_t i;
+
+	for (i = 0U; i < ARRAY_SIZE(rimps_domains); i++) {
+		const struct rimps_pll_domain *domain = &rimps_domains[i];
+
+		mmio_write_32(PLL_L_VAL(domain->base), RIMPS_COLD_BOOT_L_VAL);
+		rimps_enable_cpu_pll(domain);
+		mmio_clrsetbits_32(CFG_GFMUX(domain->base),
+				   CFG_GFMUX_GFMUX_SRC_SEL_LF_BMSK,
+				   RIMPS_GFMUX_SRC_CPUPLL_EARLY <<
+				   CFG_GFMUX_GFMUX_SRC_SEL_LF_SHFT);
+	}
+}
diff --git a/include/drivers/qti/rimps/rimps.h b/include/drivers/qti/rimps/rimps.h
new file mode 100644
index 000000000..efd03a51b
--- /dev/null
+++ b/include/drivers/qti/rimps/rimps.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * RIMPS: Silver/Gold/L3 CPU PLL bring-up plus the full OSM/DCVS runtime
+ * (CPUCP/RIMPS firmware load, VPP-derived LUT/ACD/AVG/BCL programming,
+ * APM/MEMACC init, and enabling all three OSM domains).
+ */
+
+#ifndef QTI_RIMPS_H
+#define QTI_RIMPS_H
+
+/*
+ * One-time boot init: enables the Silver, Gold and L3 CPU PLLs and switches
+ * each domain's mux onto its PLL at a safe cold-boot frequency. Must run
+ * before pcu_sequencer_init(), since RIMPS's opcode sequences assume the
+ * PLLs are already locked and outputting.
+ */
+void rimps_cpu_pll_init(void);
+
+/*
+ * Full OSM/DCVS bring-up: loads the CPUCP firmware, derives each domain's
+ * LUT/ACD/AVG/BCL/APM/MEMACC configuration from the VPP voltage plan, and
+ * enables the L3, Silver and Gold OSM domains with an initial perf-state
+ * request. Must run after rimps_cpu_pll_init() and vpp_init(), and
+ * before cprh_init() (whose closed-loop AVS controller assumes OSM is
+ * already enabled and voting).
+ */
+void rimps_dcvs_init(void);
+
+#endif /* QTI_RIMPS_H */

