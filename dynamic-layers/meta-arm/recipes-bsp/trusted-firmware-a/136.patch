diff --git a/drivers/qti/saw/shikra/saw_hwio.h b/drivers/qti/saw/shikra/saw_hwio.h
new file mode 100644
index 000000000..b3fef9444
--- /dev/null
+++ b/drivers/qti/saw/shikra/saw_hwio.h
@@ -0,0 +1,36 @@
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * shikra SAW4 AVS register map. Only SAW4_AVS_CTL is needed: the other
+ * SAW4 registers (VCTL, STS, LIMIT, DLY, PMIC_STS) belong exclusively to
+ * the aging/voltage-ramp HAL functions, which are not ported.
+ */
+
+#ifndef SAW_HWIO_H
+#define SAW_HWIO_H
+
+#define HWIO_SAW4_AVS_CTL_ADDR(x)		((x) + 0x104U)
+
+#define HWIO_SAW4_AVS_CTL_VLVL_STEP_DN_BMSK	0xff000000UL
+#define HWIO_SAW4_AVS_CTL_VLVL_STEP_DN_SHFT	24U
+#define HWIO_SAW4_AVS_CTL_VLVL_STEP_UP_BMSK	0xff0000UL
+#define HWIO_SAW4_AVS_CTL_VLVL_STEP_UP_SHFT	16U
+#define HWIO_SAW4_AVS_CTL_CPR_RAMP_EN_BMSK	0x8000U
+#define HWIO_SAW4_AVS_CTL_CPR_RAMP_EN_SHFT	15U
+#define HWIO_SAW4_AVS_CTL_VCTL_RAMP_EN_BMSK	0x4000U
+#define HWIO_SAW4_AVS_CTL_VCTL_RAMP_EN_SHFT	14U
+#define HWIO_SAW4_AVS_CTL_TMR_CLK_DIV_BMSK	0x1f00U
+#define HWIO_SAW4_AVS_CTL_TMR_CLK_DIV_SHFT	8U
+#define HWIO_SAW4_AVS_CTL_VLVL_WIDTH_BMSK	0x20U
+#define HWIO_SAW4_AVS_CTL_VLVL_WIDTH_SHFT	5U
+#define HWIO_SAW4_AVS_CTL_CTL_SEL_BMSK		0x10U
+#define HWIO_SAW4_AVS_CTL_CTL_SEL_SHFT		4U
+#define HWIO_SAW4_AVS_CTL_EN_BMSK		0x1U
+#define HWIO_SAW4_AVS_CTL_EN_SHFT		0U
+
+/* shikra has a single AVS rail (APC0). */
+#define SAW_AVS_BASE_ADDR			0x0F900800U
+
+#endif /* SAW_HWIO_H */
diff --git a/include/drivers/qti/saw/saw.h b/include/drivers/qti/saw/saw.h
new file mode 100644
index 000000000..d6ae6e5f8
--- /dev/null
+++ b/include/drivers/qti/saw/saw.h
@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * SAW4 AVS (Adaptive Voltage Scaling) public API.
+ *
+ * The SAW4 AVS_CTL register arbitrates between SW and CPRH hardware control
+ * of the rail voltage. CPRH's boot-init sequence configures the ramp timing
+ * then hands control to hardware via saw_avs_enable(1).
+ */
+
+#ifndef SAW_H
+#define SAW_H
+
+#include <stdint.h>
+
+/* saw_avs_enable - hand control of the Vdd level to hardware (CPRH). */
+void saw_avs_enable(uint32_t enable);
+
+/* saw_avs_ramp_en - enable CPR/VCTL voltage ramping. */
+void saw_avs_ramp_en(uint32_t ramp_en);
+
+/* saw_avs_set_clock_divider - AVS timer clock divider. */
+void saw_avs_set_clock_divider(uint32_t divider);
+
+/*
+ * saw_avs_set_voltage_step_size - max up/down voltage step per AVS timer
+ * tick. Faithfully preserves the vendor HAL's swapped assignment: step_up
+ * programs the VLVL_STEP_DN field and step_dn programs VLVL_STEP_UP.
+ */
+void saw_avs_set_voltage_step_size(uint32_t step_up, uint32_t step_dn);
+
+/* saw_avs_set_voltage_width - width of each AVS voltage level step. */
+void saw_avs_set_voltage_width(uint32_t width);
+
+#endif /* SAW_H */

