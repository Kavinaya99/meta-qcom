+#define VPP_PTE_MCN_IDENTIFIER	VPP_HWIO_INM(QFPROM_CORR_PTE_ROW3_LSB, PTE_MCN_IDENTIFIER)
+#define VPP_VP_ID		VPP_HWIO_INM(QFPROM_CORR_QC_SPARE_REG20_LSB, SW_SPT_LOCAL_RAILS_VPID)
