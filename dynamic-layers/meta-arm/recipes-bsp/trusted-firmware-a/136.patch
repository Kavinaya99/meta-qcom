+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Curated RIMPS register definitions for shikra: CPU PLL bring-up plus
+ * the OSM/DCVS runtime (ACD/AVG, APM, MEMACC, RIMPS/EPSS CPUCP, misc clocks).
+ */
+
+#ifndef RIMPS_HWIO_H
+#define RIMPS_HWIO_H
+
+#include <shikra_def.h>
+
+/* Loads the CPUCP firmware image into the RIMPS/EPSS TCM; defined in
+ * rimps_fw.c.
+ */
+void rimps_fw_load(void);
+
+/* Per-domain APSS KRYO clock-control base; PLL_MODE/PLL_L_VAL/CFG_GFMUX hang
+ * off this base at the same offsets for all three CPU PLL domains.
+ */
+#define SILVER_APSS_KRYO_CLK_CTL_BASE	(QTI_APSS_HM_BASE + 0x00a80000U)
+#define GOLD_APSS_KRYO_CLK_CTL_BASE	(QTI_APSS_HM_BASE + 0x00a84000U)
+#define L3_APSS_KRYO_CLK_CTL_BASE	(QTI_APSS_HM_BASE + 0x00a88000U)
+
+#define PLL_MODE(base)			((base) + 0x0U)
+#define PLL_MODE_PLL_LOCK_DET_BMSK	0x80000000U
+#define PLL_MODE_PLL_LOCK_DET_SHFT	31U
+#define PLL_MODE_RESET_N_BMSK		0x4U
+#define PLL_MODE_RESET_N_SHFT		2U
+#define PLL_MODE_BYPASSNL_BMSK		0x2U
+#define PLL_MODE_BYPASSNL_SHFT		1U
+#define PLL_MODE_OUTCTRL_BMSK		0x1U
+#define PLL_MODE_OUTCTRL_SHFT		0U
+
+#define PLL_L_VAL(base)			((base) + 0x4U)
+
+#define PLL_USER_CTL(base)		((base) + 0xcU)
+#define PLL_USER_CTL_POSTDIV_CTL_BMSK	0x300U
+#define PLL_USER_CTL_POSTDIV_CTL_SHFT	8U
+
+#define CFG_GFMUX(base)			((base) + 0x84U)
+#define CFG_GFMUX_GFMUX_SRC_SEL_LF_BMSK	0xfU
+#define CFG_GFMUX_GFMUX_SRC_SEL_LF_SHFT	0U
+
+/* Gold-only: clears the PLL power-down bit left set by cold reset, ahead of
+ * the generic PLL_MODE bring-up sequence.
+ */
+#define GOLD_PLL_APC_PDN		(QTI_APSS_HM_BASE + 0x00880204U)
+#define GOLD_PLL_APC_PDN_BMSK		0x1U
+
+/*
+ * ACD_THRTL_CTL hangs off the same per-domain KRYO clock-control base as
+ * PLL_MODE/PLL_L_VAL/CFG_GFMUX above.
+ */
+#define ACD_THRTL_CTL(base)				((base) + 0x90U)
+#define ACD_THRTL_CTL_LLM_ACD_THROTTLE_EN_BMSK		0x1U
+#define ACD_THRTL_CTL_LLM_ACD_THROTTLE_EN_SHFT		0U
+
+/*
+ * OSM-top (RIMPSSLOW_CLKDOMn_CDn) per-domain base. L3 uses CD0, Silver CD1,
+ * Gold CD2 -- fixed by hardware wiring, not configurable.
+ */
+#define L3_OSM_TOP_BASE			(QTI_APSS_HM_BASE + 0x00d90000U)
+#define SILVER_OSM_TOP_BASE		(QTI_APSS_HM_BASE + 0x00d91000U)
+#define GOLD_OSM_TOP_BASE		(QTI_APSS_HM_BASE + 0x00d92000U)
+
+#define RIMPS_ENABLE(base)			((base) + 0x0U)
+#define RIMPS_ENABLE_RIMPS_EN_BMSK		0x1U
+#define RIMPS_ENABLE_RIMPS_EN_SHFT		0U
+
+#define CC_HYS_INC(base)			((base) + 0x4U)
+#define CC_HYS_INC_VALUE_BMSK			0xffffU
+#define CC_HYS_INC_VALUE_SHFT			0U
+
+#define CC_HYS_DEC(base)			((base) + 0x8U)
+#define CC_HYS_DEC_VALUE_BMSK			0xffffU
+#define CC_HYS_DEC_VALUE_SHFT			0U
+
+#define CC_DCVS(base)				((base) + 0xcU)
+#define CC_DCVS_EN_BMSK				0x1U
+#define CC_DCVS_EN_SHFT				0U
+
+#define MAX_CORE_CNT(base)			((base) + 0x14U)
+#define MAX_CORE_CNT_VALUE_BMSK			0xfU
+#define MAX_CORE_CNT_VALUE_SHFT			0U
+
+#define LLM_DCVS_VC_VOTE(base)			((base) + 0x24U)
+#define LLM_DCVS_VC_VOTE_THROTTLE_EN_BMSK	0x8000U
+#define LLM_DCVS_VC_VOTE_THROTTLE_EN_SHFT	15U
+
+#define LLM_DCVS_VOL_VOTE(base)			((base) + 0x28U)
+#define LLM_DCVS_VOL_VOTE_VMIN_BMSK		0xfffU
+#define LLM_DCVS_VOL_VOTE_VMIN_SHFT		0U
+
+#define LLM_FMAX_HYS_TIMER_INC(base)		((base) + 0x30U)
+#define LLM_FMAX_HYS_TIMER_INC_VALUE_BMSK	0xffffU
+#define LLM_FMAX_HYS_TIMER_INC_VALUE_SHFT	0U
+
+#define LLM_FMAX_HYS_TIMER_DEC(base)		((base) + 0x34U)
+#define LLM_FMAX_HYS_TIMER_DEC_VALUE_BMSK	0xffffU
+#define LLM_FMAX_HYS_TIMER_DEC_VALUE_SHFT	0U
+
+#define LLM_VMAX_HYS_TIMER_INC(base)		((base) + 0x38U)
+#define LLM_VMAX_HYS_TIMER_INC_VALUE_BMSK	0xffffU
+#define LLM_VMAX_HYS_TIMER_INC_VALUE_SHFT	0U
+
+#define LLM_VMAX_HYS_TIMER_DEC(base)		((base) + 0x3cU)
+#define LLM_VMAX_HYS_TIMER_DEC_VALUE_BMSK	0xffffU
+#define LLM_VMAX_HYS_TIMER_DEC_VALUE_SHFT	0U
+
+#define LLM_VMIN_HYS_TIMER_INC(base)		((base) + 0x40U)
+#define LLM_VMIN_HYS_TIMER_INC_VALUE_BMSK	0xffffU
+#define LLM_VMIN_HYS_TIMER_INC_VALUE_SHFT	0U
+
+#define LLM_VMIN_HYS_TIMER_DEC(base)		((base) + 0x44U)
+#define LLM_VMIN_HYS_TIMER_DEC_VALUE_BMSK	0xffffU
+#define LLM_VMIN_HYS_TIMER_DEC_VALUE_SHFT	0U
+
+#define FVA_INT_EN(base)			((base) + 0x58U)
+#define FVA_INT_EN_INT_EN_BMSK			0x1U
+#define FVA_INT_EN_INT_EN_SHFT			0U
+
+#define CORE_DCVS_CTRL(base)			((base) + 0xb0U)
+#define CORE_DCVS_CTRL_L3_VOTING_PWR_STATE_BMSK	0xe00U
+#define CORE_DCVS_CTRL_L3_VOTING_PWR_STATE_SHFT	9U
+#define CORE_DCVS_CTRL_CYCLE_CNTR_EN_BMSK	0x100U
+#define CORE_DCVS_CTRL_CYCLE_CNTR_EN_SHFT	8U
+#define CORE_DCVS_CTRL_PER_CORE_DCVS_EN_BMSK	0x1U
+#define CORE_DCVS_CTRL_PER_CORE_DCVS_EN_SHFT	0U
+
+#define CORE_PS_HYS(base)			((base) + 0xb8U)
+#define CORE_PS_HYS_INACT_TO_ACT_TIMER_BMSK	0xffff0000U
+#define CORE_PS_HYS_INACT_TO_ACT_TIMER_SHFT	16U
+#define CORE_PS_HYS_ACT_TO_INACT_TIMER_BMSK	0xffffU
+#define CORE_PS_HYS_ACT_TO_INACT_TIMER_SHFT	0U
+
+#define SHARED_RAIL_BOOST(base)			((base) + 0xbcU)
+#define SHARED_RAIL_BOOST_EN_BMSK		0x1U
+#define SHARED_RAIL_BOOST_EN_SHFT		0U
+
+#define LLM_THROTTLE_AMNT_HYS_INC(base)		((base) + 0xd0U)
+#define LLM_THROTTLE_AMNT_HYS_INC_CNT_BMSK	0xffffU
+#define LLM_THROTTLE_AMNT_HYS_INC_CNT_SHFT	0U
+
+#define LLM_THROTTLE_AMNT_HYS_DEC(base)		((base) + 0xd4U)
+#define LLM_THROTTLE_AMNT_HYS_DEC_CNT_BMSK	0xffffU
+#define LLM_THROTTLE_AMNT_HYS_DEC_CNT_SHFT	0U
+
+#define PLL_FSM_CTRL(base)			((base) + 0xd8U)
+#define PLL_FSM_CTRL_LVAL_CHNG_WAIT_BMSK	0xf000U
+#define PLL_FSM_CTRL_LVAL_CHNG_WAIT_SHFT	12U
