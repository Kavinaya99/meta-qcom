 }
 
+static int clock_enable_gpu_smmu_gds(void)
+{
+	uint32_t retry = CLOCK_GDSC_POLL_RETRIES;
+
+	if ((mmio_read_32(GCC_TZ_VOTE_GPU_SMMU_GDS) &
+	     GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_BMSK) != 0U) {
+		gpu_smmu_gds_enabled_by_tfa = true;
+	}
+
+	mmio_clrsetbits_32(GCC_TZ_VOTE_GPU_SMMU_GDS,
+			   GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_BMSK,
+			   0U << GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_SHFT);
+	while (((mmio_read_32(GCC_TZ_VOTE_GPU_SMMU_GDS) &
+		 GCC_TZ_VOTE_GPU_SMMU_GDS_PWR_ON_BMSK) == 0U) &&
+	       (--retry > 0U)) {
+		udelay(CLOCK_STEP_DELAY_US);
+	}
+
+	if (retry == 0U) {
+		ERROR("Clock: GPU SMMU GDS stays off\n");
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static int clock_enable_gpu_smmu_clk(void)
+{
+	uint32_t retry = CLOCK_GDSC_POLL_RETRIES;
+
+	if ((mmio_read_32(GCC_TZ_VOTE_GPU_SMMU_CLK) &
+	     GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_ENABLE_BMSK) == 0U) {
+		gpu_smmu_clk_enabled_by_tfa = true;
+	}
+
+	mmio_setbits_32(GCC_TZ_VOTE_GPU_SMMU_CLK,
+			GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_ENABLE_BMSK);
+	while (((mmio_read_32(GCC_TZ_VOTE_GPU_SMMU_CLK) &
+		 GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_OFF_BMSK) != 0U) &&
+	       (--retry > 0U)) {
+		udelay(CLOCK_STEP_DELAY_US);
+	}
+
+	if (retry == 0U) {
+		ERROR("Clock: GPU SMMU clock stays off\n");
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+static void clock_disable_gpu_smmu_clk(void)
+{
+	if (!gpu_smmu_clk_enabled_by_tfa) {
+		return;
+	}
+
+	mmio_clrbits_32(GCC_TZ_VOTE_GPU_SMMU_CLK,
+			GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_ENABLE_BMSK);
+	gpu_smmu_clk_enabled_by_tfa = false;
+}
+
+static void clock_disable_gpu_smmu_gds(void)
+{
+	uint32_t retry = CLOCK_GDSC_POLL_RETRIES;
+
+	if (!gpu_smmu_gds_enabled_by_tfa) {
+		return;
+	}
+
+	mmio_setbits_32(GCC_TZ_VOTE_GPU_SMMU_GDS,
+			GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_BMSK);
+	while (((mmio_read_32(GCC_TZ_VOTE_GPU_SMMU_GDS) &
+		 GCC_TZ_VOTE_GPU_SMMU_GDS_PWR_ON_BMSK) != 0U) &&
+	       (--retry > 0U)) {
+		udelay(CLOCK_STEP_DELAY_US);
+	}
+
+	if (retry == 0U) {
+		WARN("Clock: GPU SMMU GDS power-down timed out\n");
+	}
+
+	gpu_smmu_gds_enabled_by_tfa = false;
+}
