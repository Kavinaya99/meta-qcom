+#define GCC_TZ_VOTE_GPU_SMMU_GDS_PWR_ON_SHFT	31U
+#define GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_BMSK	0x1U
+#define GCC_TZ_VOTE_GPU_SMMU_GDS_SW_COLLAPSE_SHFT	0U
+#define GCC_TZ_VOTE_GPU_SMMU_CLK	0x0147B06CU
+#define GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_OFF_BMSK	0x80000000U
+#define GCC_TZ_VOTE_GPU_SMMU_CLK_CLK_OFF_SHFT	31U
