From fd62dde1d5227eb81a6d1529be86f25fc08f97f8 Mon Sep 17 00:00:00 2001
From: Somesh Velupally <somegupt@qti.qualcomm.com>
Date: Wed, 25 Nov 2026 17:30:17 +0530
Subject: [PATCH 2/3] fix(qti): disable unused SNOC a2noc MPU region for Shikra

  Clear the SNOC a2noc MPU region at index 0 by replacing MSA_DOMAIN
  read/write VMIDs with NO_DOMAIN and setting the address range to
  0xffffffff. This disables a previously configured MSA region that
  is not applicable for this platform.

Signed-off-by: Somesh Velupally <somegupt@qti.qualcomm.com>
---
 drivers/qti/accesscontrol/cfg/shikra/xpu_static_config.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/qti/accesscontrol/cfg/shikra/xpu_static_config.c b/drivers/qti/accesscontrol/cfg/shikra/xpu_static_config.c
index 2a11034f6..d9d2cd8eb 100644
--- a/drivers/qti/accesscontrol/cfg/shikra/xpu_static_config.c
+++ b/drivers/qti/accesscontrol/cfg/shikra/xpu_static_config.c
@@ -2592,10 +2592,10 @@ struct rg_mpu_cfg snoc_a2noc_mpu_cfg[] = {
 {
 	.index         = 0,
 	.flags         = APPS_S_DOMAIN,
-	.read_vmid     = MSA_DOMAIN,
-	.write_vmid    = MSA_DOMAIN,
-	.start         = 0x05800000,
-	.end           = 0x05880000,
+	.read_vmid     = NO_DOMAIN,
+	.write_vmid    = NO_DOMAIN,
+	.start         = 0xffffffff,
+	.end           = 0xffffffff,
 },
 {
 	.index         = 1,

From 0247e31821c8804640a89d3b9619e0acda1a4b61 Mon Sep 17 00:00:00 2001
From: Somesh Velupally <somegupt@qti.qualcomm.com>
Date: Wed, 25 Nov 2026 17:30:40 +0530
Subject: [PATCH 3/3] fix(qti): defer bypass pointer init until after NULL
 check in vmidmt_hal

  Move the initialization of bypass_bus and bypass_aux in
  set_default_config() to after the cfg NULL guard. Previously these
  pointers were derived from cfg before the NULL check, risking a NULL
  dereference if an invalid cfg was passed.

Signed-off-by: Somesh Velupally <somegupt@qti.qualcomm.com>
---
 drivers/qti/accesscontrol/vmidmt/vmidmt_hal.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/qti/accesscontrol/vmidmt/vmidmt_hal.c b/drivers/qti/accesscontrol/vmidmt/vmidmt_hal.c
index 445a002b0..62182d456 100644
--- a/drivers/qti/accesscontrol/vmidmt/vmidmt_hal.c
+++ b/drivers/qti/accesscontrol/vmidmt/vmidmt_hal.c
@@ -163,8 +163,8 @@ static enum hal_vmidmt_status
 set_default_config(const struct hal_vmidmt_info *p,
 		   const struct hal_vmidmt_default_vmid_config *cfg, bool sec)
 {
-	struct hal_vmidmt_bus_attrib *bypass_bus = cfg->p_bypass_bus_attrib;
-	struct hal_vmidmt_aux_config *bypass_aux = cfg->p_bypass_aux_config;
+	struct hal_vmidmt_bus_attrib *bypass_bus;
+	struct hal_vmidmt_aux_config *bypass_aux;
 	uint32_t attrib = 0;
 	uint32_t config = 0;
 	uint32_t val = 0;
@@ -173,6 +173,9 @@ set_default_config(const struct hal_vmidmt_info *p,
 	if (!cfg)
 		return HAL_VMIDMT_INVALID_PARAM;
 
+	bypass_bus = cfg->p_bypass_bus_attrib;
+	bypass_aux = cfg->p_bypass_aux_config;
+
 	if (bypass_bus &&
 	    bypass_bus->mem_attr > (1 << VMIDMT_MEMATTR_MAX_BITS) - 1)
 		return HAL_VMIDMT_INVALID_PARAM;
