+static int _kgsl_set_smmu_aperture_direct(struct kgsl_device *device,
+		u32 aperture_offset, u32 num_context_bank)
+{
+	struct kgsl_iommu *iommu = KGSL_IOMMU(device);
+	u32 cb_reg_offset;
+
+	if (!iommu->aperture_regbase)
+		return -ENODEV;
+
+	cb_reg_offset = (iommu->regbase_phys + iommu->cb0_offset +
+		(num_context_bank * iommu->pagesize)) & 0xFFFFF;
+
+	writel_relaxed(cb_reg_offset, iommu->aperture_regbase + aperture_offset);
+
+	/* Make sure all of the preceding writes have posted */
+	wmb();
+
+	return 0;
+}
+
+static int _kgsl_set_smmu_aperture(struct kgsl_device *device,
+		u32 num_context_bank)
+{
+	struct kgsl_mmu *mmu = &device->mmu;
+	int status = 0;
+
+	status = _kgsl_set_smmu_aperture_scm(num_context_bank);
+
+	if(status) {
+	/* if zap is enabled and scm calls fail, return error*/
+		if(mmu->zap_enabled)
+			return -ENODEV;
+		else
+			return _kgsl_set_smmu_aperture_direct(device,
+			KGSL_IOMMU_APERTURE_S1CB0, num_context_bank);
+	}
+	return status;
+}
+
+static void _kgsl_set_smmu_aperture_ctl(struct kgsl_device *device)
+{
+	struct kgsl_iommu *iommu = KGSL_IOMMU(device);
+
+	if (!iommu->aperture_regbase)
+		return;
+
+	writel_relaxed(KGSL_IOMMU_APERTURE_CTL_S1CB1_EN,
+			iommu->aperture_regbase + KGSL_IOMMU_APERTURE_CTL);
+	wmb();
+}
