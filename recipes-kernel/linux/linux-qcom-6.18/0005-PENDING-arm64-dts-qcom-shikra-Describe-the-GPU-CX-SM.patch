From 02f62075123a2603ff596502646bb996a736da72 Mon Sep 17 00:00:00 2001
From: Lokesh Kumar <lok@qti.qualcomm.com>
Date: Thu, 12 Nov 2026 01:25:47 +0530
Subject: [PATCH 5/5] PENDING: arm64: dts: qcom: shikra: Describe the GPU CX
 SMMU aperture

Describe the GPU's CX SMMU aperture redirect block as its own reg
region so the DRM/MSM (and KGSL) drivers can program it directly when
the secure world doesn't implement the aperture SCM call.

Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/shikra.dtsi | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/shikra.dtsi b/arch/arm64/boot/dts/qcom/shikra.dtsi
index b53365f7eeaf..7da179969963 100644
--- a/arch/arm64/boot/dts/qcom/shikra.dtsi
+++ b/arch/arm64/boot/dts/qcom/shikra.dtsi
@@ -3149,10 +3149,12 @@ gpu: gpu@5900000 {
 			compatible = "qcom,adreno-07000400", "qcom,adreno";
 			reg = <0x0 0x05900000 0x0 0x40000>,
 			      <0x0 0x0599e000 0x0 0x1000>,
-			      <0x0 0x05961000 0x0 0x800>;
+			      <0x0 0x05961000 0x0 0x800>,
+			      <0x0 0x05960000 0x0 0x1000>;
 			reg-names = "kgsl_3d0_reg_memory",
 				    "cx_mem",
-				    "cx_dbgc";
+				    "cx_dbgc",
+				    "cx_smmu_aperture";
 
 			interrupts = <GIC_SPI 177 IRQ_TYPE_LEVEL_HIGH 0>;

