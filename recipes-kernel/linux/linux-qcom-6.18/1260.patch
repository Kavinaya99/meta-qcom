From 55ae639a9887178d7fce0a5d37127ab653abbdaa Mon Sep 17 00:00:00 2001
From: Bibek Kumar Patro <bibek.patro@oss.qualcomm.com>
Date: Thu, 8 Oct 2026 20:16:46 +0530
Subject: [PATCH 1/4] arm64: dts: qcom: shikra: Add OP-TEE firmware node

Add the OP-TEE firmware node to enable the Trusted Execution
Environment on Shikra. This is required for remoteproc subsystems
that use OP-TEE as the secure backend for firmware authentication
and boot (e.g. lpaicp which has auto_boot = false and relies on
the TEE PAS service for controlled startup).

Change-Id: I139ff6b6e658ff41d0b792bf2029300017019d84
Upstream-Status: Pending
Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/shikra.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/shikra.dtsi b/arch/arm64/boot/dts/qcom/shikra.dtsi
index 23dd13b0aa45..75c13d8b5ff4 100644
--- a/arch/arm64/boot/dts/qcom/shikra.dtsi
+++ b/arch/arm64/boot/dts/qcom/shikra.dtsi
@@ -250,6 +250,11 @@
 	};
 
 	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+
 		scm {
 			compatible = "qcom,scm-shikra", "qcom,scm";
 			clocks = <&rpmcc RPM_SMD_CE1_CLK>;

From b8847ef117cd4f55bc4028f89134c34a066cc7f1 Mon Sep 17 00:00:00 2001
